<web-app>
  <display-name>An application for students</display-name>
  <context-param>
    <param-name>Ahmet's App</param-name>
    <param-value>Meine App für Studenten</param-value>
  </context-param>

  <listener>
    <listener-class>hbv.MyContextListener</listener-class>
  </listener>

  <servlet>
    <servlet-name>pageNotFound</servlet-name>
    <servlet-class>hbv.Servlets.PageNotFound</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>login</servlet-name>
    <servlet-class>hbv.Servlets.LoginServlet</servlet-class>
  </servlet>

  <servlet>
    <servlet-name>register</servlet-name>
    <servlet-class>hbv.Servlets.RegisterServlet</servlet-class>
  </servlet>

  <servlet> 
    <servlet-name>studiengang</servlet-name>
    <servlet-class>hbv.Servlets.StudiengangServlet</servlet-class>
  </servlet>
  
  <servlet> 
    <servlet-name>kurs</servlet-name>
    <servlet-class>hbv.Servlets.KursServlet</servlet-class>
  </servlet>

  <servlet> 
    <servlet-name>user</servlet-name>
    <servlet-class>hbv.Servlets.UserServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>pageNotFound</servlet-name>
    <url-pattern>/page-not-found</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>register</servlet-name>
    <url-pattern>/register</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>studiengang</servlet-name>
    <url-pattern>/studiengang</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>studiengang</servlet-name>
    <url-pattern>/studiengang/*</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>kurs</servlet-name>
    <url-pattern>/kurs/*</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>user</servlet-name>
    <url-pattern>/user</url-pattern>
  </servlet-mapping>

  <servlet-mapping>
    <servlet-name>user</servlet-name>
    <url-pattern>/user/*</url-pattern>
  </servlet-mapping>

  <filter>
    <filter-name>myfilter</filter-name>
    <filter-class>hbv.MyFilter</filter-class>
    <async-supported>true</async-supported>
  </filter>

  <filter-mapping>
    <filter-name>myfilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <error-page>
    <error-code>404</error-code>
    <location>/404.html</location>
  </error-page>

</web-app>  